# Copy to .env for local dev (or set these in Vercel project settings).

# Telegram BotFather token. ROTATE the one you pasted in chat — it's compromised.
TELEGRAM_BOT_TOKEN=

# OpenAI key — used for embeddings always, and for chat fallback when NVIDIA fails.
OPENAI_API_KEY=

# NVIDIA NIM key (optional). If set, used as the primary chat model (free tier).
NVIDIA_API_KEY=
NVIDIA_MODEL=qwen/qwen3-235b-a22b
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Comma-separated Telegram user IDs allowed to use /reload. Find yours by
# messaging @userinfobot. Example: 123456789,987654321
ADMIN_CHAT_IDS=
